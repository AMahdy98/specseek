# Copy to .env (gitignored) and fill in. Never commit .env.
DATABASE_URL=postgresql://specseek:specseek@localhost:5432/specseek
LOG_LEVEL=info
# From https://aistudio.google.com
GEMINI_API_KEY=
# Optional (defaults shown)
# EMBEDDING_MODEL=gemini-embedding-001
# GENERATION_MODEL=gemini-3.5-flash-lite
# DATA_DIR=data
# Browser origins allowed to call the API, comma-separated (the Vite dev server by default)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Rate limit on POST /v1/query (the provider allows 15 generations per minute)
# QUERY_RATE_PER_MINUTE=12
# QUERY_BURST=6
