.ruff_cache/

# Secrets / local config
.env

# Standards PDFs (see docs/DECISIONS.md, "Corpus licensing policy").
# data/local/  = licensed docs (CiA, ISO/IEC): never committed, never deployed.
# data/public/ = public-domain docs; still ignored until we decide in phase 2 whether to commit them.
data/local/
data/**/*.pdf

# Eval raw outputs can be large; commit the graded summary in docs/EVAL.md instead
eval/runs/

# Editors / OS
.vscode/
.idea/
*:Zone.Identifier
